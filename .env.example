# Copier en .env pour le développement local. En production, ces valeurs
# vivent dans /etc/trains/trains.env (généré par deploy.sh, mode 600).

# development | production | test
NODE_ENV=development

# Port d'écoute de l'API Fastify (en production, choisi automatiquement
# à partir de 3070 par deploy.sh).
PORT=3070

# Adresse d'écoute. Laisser 127.0.0.1 : seul Nginx doit joindre l'API.
HOST=127.0.0.1

# URL publique, utilisée pour les liens de partage et les images Open Graph.
PUBLIC_URL=http://localhost:5173

# Secret de signature des cookies de session : 64 caractères hexadécimaux
# minimum. Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Fichier SQLite (créé au démarrage s'il n'existe pas).
DATABASE_PATH=./.local/trains.sqlite

# Répertoire des données générées par packages/data (communes, gares,
# altitude, PMTiles…).
DATA_DIR=./.local/data

# Niveau de log pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
