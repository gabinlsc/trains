{
  "name": "@trains/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Fastify de Rails de France.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@trains/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0"
  }
}
